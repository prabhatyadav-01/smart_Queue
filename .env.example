# Copy to .env and fill in. `npm start` / `npm run dev` loads it automatically.

# Port the server listens on
PORT=3000

# Supabase Postgres Connection String
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use Transaction Pooler (port 6543) or Session/Direct (port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Project API Credentials
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Google OAuth Client ID (optional if using Supabase Auth Google provider directly,
# or provide to enable Google One Tap / Google Identity Services button)
# Create in Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs (Web application)
GOOGLE_CLIENT_ID=

# Required in production: at least 32 random characters.
# Used to sign short-lived tokens and to encrypt authenticator secrets at rest.
# In development a secret is generated once and stored in data/.app-secret.
APP_SECRET=

# First admin account (created on first start if no admin exists).
# If left empty in development, a random password is printed to the console once.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to 1 when running behind a reverse proxy (nginx, Render, Railway…)
TRUST_PROXY=0

# Public URL when behind a proxy, used for the CSRF origin check (e.g. https://queue.example.com)
PUBLIC_ORIGIN=

# 1 = simulated walk-ins and counters so the live screens move during a demo.
# Defaults to on in development and off in production.
DEMO_MODE=

# production enables Secure/__Host- cookies, HSTS and requires APP_SECRET
NODE_ENV=development
